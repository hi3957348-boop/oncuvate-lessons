rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return signedIn() && request.auth.token.email != null;
    }

    match /classes/{classId}/students/{studentId} {
      allow read: if isTeacher();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isTeacher() || (signedIn() && resource.data.uid == request.auth.uid);

      match /messages/{messageId} {
        allow read: if isTeacher() || (
          signedIn() &&
          get(/databases/$(database)/documents/classes/$(classId)/students/$(studentId)).data.uid == request.auth.uid
        );
        allow write: if isTeacher();
      }

      match /shared/{documentId} {
        allow read: if isTeacher() || (
          signedIn() &&
          get(/databases/$(database)/documents/classes/$(classId)/students/$(studentId)).data.uid == request.auth.uid
        );
        allow write: if isTeacher();
      }
    }
  }
}
